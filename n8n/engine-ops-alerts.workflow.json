        }
      },
      "id": "http-recs",
      "name": "Fetch sampling queue",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "// Diff today's top-10 sampling queue against every creator seen in it before.\nconst cands = ($json.candidates || []).map(c => ({\n  id: c.creator_id, handle: c.handle, rank: c.rank,\n  product: c.suggested_product, reason: c.reasons\n}));\nconst store = $getWorkflowStaticData('global');\nconst seen = new Set(store.queueSeen || []);\nconst fresh = cands.filter(c => !seen.has(c.id));\nstore.queueSeen = [...new Set([...(store.queueSeen || []), ...cands.map(c => c.id)])];\nreturn fresh.map(c => ({ json: c }));"
      },
      "id": "code-diff",
      "name": "Diff vs queue history",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.handle }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-new",
      "name": "Anyone new?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        740,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.DISCORD_WEBHOOK_URL }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ content: '🎯 New in the top-10 sampling queue: ' + $json.handle + ' (rank ' + $json.rank + ') — ' + $json.product + '. ' + ($json.reason || '') }) }}",
        "options": {}
      },
      "id": "post-new",
      "name": "Alert: new queue entrant",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
