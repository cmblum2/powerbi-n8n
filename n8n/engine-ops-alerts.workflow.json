      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "// One-line daily health digest from the engine's drift monitor.\nconst d = $json;\nconst flags = (d.flags || []).length;\nconst line = '📊 Sampling-engine health — ranking skill ' + d.skill.current +\n  ' (baseline ' + d.skill.baseline + ') · hit rate ' + (d.hit_rate.current * 100).toFixed(1) +\n  '% · max PSI ' + d.max_psi.value + ' (' + d.max_psi.feature + ') · ' +\n  (flags ? '⚠️ ' + flags + ' drift flag(s)!' : '✅ no drift flags');\nreturn [{ json: { content: line } }];"
      },
      "id": "code-digest",
      "name": "Build health digest",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        180
      ]
    },
