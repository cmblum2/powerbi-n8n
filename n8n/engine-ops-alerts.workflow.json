        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ content: $json.content }) }}",
        "options": {}
      },
      "id": "post-digest",
      "name": "Post daily health digest",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
