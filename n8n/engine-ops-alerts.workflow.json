      "id": "http-decisions",
      "name": "Fetch decision queue",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        400
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "// Alert when a campaign's scale/cut verdict flips vs the last recorded run.\n// First run records a baseline (one summary message); later runs alert only on flips.\nconst items = ($json.queue || []).filter(a => a.type === 'campaign');\nconst store = $getWorkflowStaticData('global');\nconst prev = store.campaignVerdicts || null;\nconst now = {};\nfor (const c of items) now[c.campaign_id] = { verdict: c.action, name: c.target };\nconst out = [];\nif (!prev) {\n  const counts = {};\n  for (const c of items) counts[c.action] = (counts[c.action] || 0) + 1;\n  const summary = Object.entries(counts).map(([v, n]) => n + ' ' + v).join(' · ');\n  out.push({ json: { content: '⚡ Campaign verdict baseline recorded — ' + items.length + ' campaigns: ' + summary + '. Verdict flips will alert from the next run.' } });\n} else {\n  for (const c of items) {\n    const was = prev[c.campaign_id];\n    if (was && was.verdict !== c.action) {\n      const why = (c.why || []).find(w => w.startsWith('→')) || '';\n      out.push({ json: { content: '⚡ Campaign flip: ' + c.target + ' — ' + was.verdict + ' → ' + c.action + '. ' + why } });\n    }\n  }\n}\nstore.campaignVerdicts = now;\nreturn out;"
      },
      "id": "code-flips",
      "name": "Diff campaign verdicts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        340
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.DISCORD_WEBHOOK_URL }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ content: $json.content }) }}",
        "options": {}
      },
      "id": "post-flips",
      "name": "Alert: campaign flip",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        740,
        340
      ],
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "// Alert once per video when its spark window opens (verdict SPARK NOW —\n// either in the 8-14 day sweet spot or aging out with momentum).\nconst sparks = ($json.queue || []).filter(a => a.type === 'spark' && a.action === 'SPARK NOW');\nconst store = $getWorkflowStaticData('global');\nconst seen = new Set(store.sparkAlerted || []);\nconst fresh = sparks.filter(s => !seen.has(s.video_id));\nstore.sparkAlerted = [...seen, ...fresh.map(s => s.video_id)];\nreturn fresh.map(s => ({ json: { content: '🔥 Spark window: ' + s.target + ' — \"' + s.title + '\" (' + s.video_id + '). ' + ((s.why || []).find(w => w.startsWith('→')) || '') } }));"
      },
      "id": "code-spark",
      "name": "Watch spark windows",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        500
      ]
    },
